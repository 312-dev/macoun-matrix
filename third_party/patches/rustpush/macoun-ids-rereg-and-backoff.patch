+/// macoun: seconds until the next IDS reregistration when Apple sent no
+/// heartbeat interval. Upstream reregisters 300 s before the ID certificate
+/// expires; in macoun-matrix that registration needs validation data from the
+/// Mac relay, so a relay outage at that moment would stop the bridge within
+/// minutes. Reregistering MACOUN_REREG_LEAD_S (7 days) early leaves days of
+/// retries (the Identity resource retries on failure). A registration less than
+/// MACOUN_REREG_MIN_AGE_S old is not repeated, so a certificate that comes back
+/// with under 7 days left cannot cause a reregister loop. Never later than
+/// upstream's 300 s before expiry. Tested from rustpushgo (macoun_tests.rs),
+/// because rustpush's own test target needs certificates that are not public.
+pub const MACOUN_REREG_LEAD_S: i64 = 7 * 86400;
+pub const MACOUN_REREG_MIN_AGE_S: i64 = 86400;
+
+pub fn macoun_rereg_in_s(expires_in_s: i64, registered_ago_s: i64) -> i64 {
+    let early = expires_in_s - MACOUN_REREG_LEAD_S;
+    let not_before = MACOUN_REREG_MIN_AGE_S - registered_ago_s;
+    early.max(not_before).min(expires_in_s - 300)
+}
